# data/sahidwar.sqlite and data/portal.sqlite are normally rebuilt by
# scripts/build_db.py, but that script is not present in this checkout, so the
# compiled databases are committed instead -- without them neither stack can
# start on a fresh clone. Only the transient sidecar files stay ignored.
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
data/.build_manifest.json

# Extraction cache — cleared on every server start (ARCHITECTURE §8)
data/cache/

# Local models — multi-GB, pulled by scripts/setup_models.py
models/
*.bin
*.gguf
*.onnx

# Pre-cached map tiles — regenerated by scripts/precache_tiles.py
data/tiles/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
scratch/
*.log

# Generated by scripts/copy_strings.py from data/strings — never edited by hand
frontend/src/i18n/generated/
frontend/src/theme/tokens.generated.css
